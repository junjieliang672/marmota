#!/usr/bin/env python3
"""Fake `pbcopy`: stores stdin in $FAKE_CLIPBOARD_FILE instead of the real clipboard."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _fakelib  # noqa: E402  pylint: disable=wrong-import-position


def main():
    _fakelib.log_call("FAKE_PBCOPY_LOG", "pbcopy", "pbcopy")
    data = sys.stdin.buffer.read()
    path = os.environ.get("FAKE_CLIPBOARD_FILE")
    if path:
        with open(path, "wb") as handle:
            handle.write(data)
    return 0


if __name__ == "__main__":
    sys.exit(main())
