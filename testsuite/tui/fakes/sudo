#!/usr/bin/env python3
"""Fake `sudo`: logs argv and refuses, so a test never escalates or blocks on a password."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _fakelib  # noqa: E402  pylint: disable=wrong-import-position


def main():
    _fakelib.log_call("FAKE_SUDO_LOG", "sudo", "sudo")
    sys.stderr.write("fake sudo: refusing to escalate privileges from a test sandbox\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
