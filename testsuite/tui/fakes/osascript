#!/usr/bin/env python3
"""Fake `osascript`: logs argv and fails, so a test can never drive the real Finder.

spf falls back to ``tell application "Finder" to delete`` when a trash rename
fails; with this fake that path reports an error instead of touching the
user's real Trash. Exit code: $FAKE_OSASCRIPT_EXIT (default 1).
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _fakelib  # noqa: E402  pylint: disable=wrong-import-position


def main():
    _fakelib.log_call("FAKE_OSASCRIPT_LOG", "osascript", "osascript")
    code = _fakelib.env_int("FAKE_OSASCRIPT_EXIT", 1)
    if code != 0:
        sys.stderr.write("fake osascript: refusing to script other apps from a test sandbox\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
